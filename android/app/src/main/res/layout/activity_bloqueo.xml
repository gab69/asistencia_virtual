<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rojo_barra"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="4dp"
        android:paddingStart="14dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/mensaje"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/blanco"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/boton_ya_marque"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="@color/verde_confirmar"
            android:paddingHorizontal="14dp"
            android:text="@string/ya_marque"
            android:textColor="@color/blanco"
            android:textSize="13sp" />

        <Button
            android:id="@+id/boton_emergencia"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/emergencia"
            android:tooltipText="@string/emergencia"
            app:icon="@drawable/ic_candado"
            app:iconTint="@color/blanco" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progreso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:visibility="gone"
        app:indicatorColor="@color/blanco"
        app:trackColor="@color/rojo_barra" />

    <WebView
        android:id="@+id/pagina"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
